              "pm.test(\"Check response tags is array\", function () {\r",
              "    pm.expect(jsonData.tags).to.be.a(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response text\", function () {\r",
              "    pm.expect(jsonData.text).to.eql(\"Пост для автотетса\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response publishDate is string\", function () {\r",
              "    pm.expect(jsonData.publishDate).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response updatedDate is string\", function () {\r",
              "    pm.expect(jsonData.updatedDate).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response publishDate = updatedDate\", function () {\r",
              "    pm.expect(jsonData.publishDate).to.eql(jsonData.updatedDate);\r",
              "});\r",
              "\r",
              "pm.test(\"Check response owner.id\", function () {\r",
              "    pm.expect(jsonData.owner.id).to.eql(\"6a02d72cbffcca9385e893a7\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response owner.title\", function () {\r",
              "    pm.expect(jsonData.owner.title).to.eql(\"ms\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response owner.firstName\", function () {\r",
              "    pm.expect(jsonData.owner.firstName).to.eql(\"Svetka\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response owner.lastName\", function () {\r",
              "    pm.expect(jsonData.owner.lastName).to.eql(\"Svetova\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response owner.picture\", function () {\r",
              "    pm.expect(jsonData.owner.picture).to.eql(\"https://avavatar.ru/image/8789\");\r",
              "});\r",
              " "
