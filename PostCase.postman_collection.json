    {
      "name": "GetPostList",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Status code contains OK\", function () {\r",
              "    pm.response.to.have.status(\"OK\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Check response data is array\", function () {\r",
              "    pm.expect(jsonData.data).to.be.a(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [0].id is string\", function () {\r",
              "    pm.expect(jsonData.data[0].id).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [0].likes is number\", function () {\r",
              "    pm.expect(jsonData.data[0].likes).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [0].owner.id is string\", function () {\r",
              "    pm.expect(jsonData.data[0].owner.id).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [0].link is undefined\", function () {\r",
              "    pm.expect(jsonData.data[0].link).to.be.a(\"undefined\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [19].id is string\", function () {\r",
              "    pm.expect(jsonData.data[19].id).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response [20] is undefined\", function () {\r",
              "    pm.expect(jsonData.data[20]).to.be.a(\"undefined\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response total is number\", function () {\r",
              "    pm.expect(jsonData.total).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check response page is 0\", function () {\r",
              "    pm.expect(jsonData.page).to.eql(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Check response limit is 20\", function () {\r",
              "    pm.expect(jsonData.limit).to.eql(20);\r",
